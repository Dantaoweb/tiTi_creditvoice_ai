DATABASE_URL=postgresql://user:password@host:5432/database
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WEBHOOK_VERIFY_TOKEN=choose_a_verify_token
# Meta App Secret — used to verify WhatsApp webhook signatures (found in Meta Developer Portal → App Settings)
META_APP_SECRET=

# Web app auth (MUST change WEB_SECRET_KEY in production — used to sign session tokens)
WEB_SECRET_KEY=cv-web-secret-change-in-production

# Anthropic Claude — tiTi conversational fallback (optional, OpenAI still handles transcription + normalization)
ANTHROPIC_API_KEY=

# WhatsApp linking nudge (optional — set to your tiTi number, e.g. 2348012345678)
TITI_WHATSAPP=

# Email delivery via Brevo SMTP (optional — required for email OTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=CreditVoice <noreply@yourdomain.com>
