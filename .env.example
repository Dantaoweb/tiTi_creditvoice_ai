# ─────────────────────────────────────────────────────────────────────────────
# CreditVoice AI — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Production: set these in Render → your service → Environment (not a file).
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development

# Comma-separated list of allowed cross-origin domains (no trailing slash).
# Production example: https://creditvoice.onrender.com
# Leave blank in development — Vite proxies /app/api so the browser sees same-origin.
CORS_ALLOWED_ORIGINS=

# Sentry error tracking — leave blank to disable (safe for local dev)
# Create a project at sentry.io, copy the DSN, set it in Render dashboard
SENTRY_DSN=

# Set to "true" on exactly ONE process/instance to run the proactive scheduler
# (low-stock alerts, overdue debt reminders). render.yaml handles this in production.
# Leave as "false" locally to avoid sending WhatsApp messages during development.
SCHEDULER_ENABLED=false

# Render Postgres → your service → Connect → External URL
DATABASE_URL=postgresql://user:password@host:5432/database

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=replace_with_64_char_hex_secret

# Meta Developer Portal → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Must match what you entered in Meta → Webhooks → Verify Token
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_VERIFY_TOKEN=replace_with_64_char_hex_secret

# Meta Developer Portal → your app → App Settings → Basic → App Secret
META_APP_SECRET=your_meta_app_secret

# tiTi's WhatsApp number in E.164 format (no + prefix)
TITI_WHATSAPP=2348000000000

# platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_PARSE_MODEL=gpt-4o-mini

# console.anthropic.com → API Keys (optional)
ANTHROPIC_API_KEY=sk-ant-...

# Public app base URL — http://localhost:8000 locally, https://yourapp.onrender.com in prod
APP_BASE_URL=http://localhost:8000

# Wallet payment link base URL
PAYMENT_LINK_BASE_URL=https://pay.creditvoice.app

# Subscription pricing in Naira
PLAN_GO_PRICE=3000
PLAN_PRO_PRICE=7000

# Bank account shown to users for manual upgrade payment
SUBSCRIPTION_BANK_NAME=your_bank_name
SUBSCRIPTION_ACCOUNT_NAME=your_account_name
SUBSCRIPTION_ACCOUNT_NUMBER=your_account_number

# WhatsApp number for support (E.164, no + prefix)
CUSTOMER_SUPPORT_PHONE=2348000000000

# app.monnify.com → Settings → API Keys
MONNIFY_API_KEY=MK_TEST_xxxx
MONNIFY_SECRET_KEY=your_monnify_secret_key
MONNIFY_CONTRACT_CODE=your_monnify_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com

# app.brevo.com → SMTP & API → SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=CreditVoice <noreply@creditvoice.app>

# Generated on pwabuilder.com after building the Android package
TWA_PACKAGE_NAME=com.creditvoice.app
TWA_SHA256_FINGERPRINT=your_sha256_fingerprint
